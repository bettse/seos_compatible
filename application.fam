# For details & more options, see documentation/AppManifests.md in firmware repo

App(
    appid="seos",  # Must be unique
    name="Seos compatible",  # Displayed in menus
    apptype=FlipperAppType.EXTERNAL,
    entry_point="seos_app",
    stack_size=10 * 1024,
    fap_category="NFC",
    # Optional values
    fap_version="1.3",
    fap_icon="seos.png",  # 10x10 1-bit PNG
    fap_description="Seos compatible reader/emulator",
    fap_author="bettse",
    fap_weburl="https://gitlab.com/bettse/flipper_seos",
    fap_icon_assets="images",  # Image assets to compile for this application
    fap_file_assets="files",
    fap_libs=["mbedtls"],
    # lib/ holds the host test suite. The two *_fal directories are built as
    # plugins below, so they must not also go into the app.
    sources=["*.c*", "!lib", "!ble_ext_fal", "!ble_native_fal"],
)

# The BLE stacks are most of the image and most sessions never use one, so
# they load on demand. fal_embedded ships them inside the .fap.
App(
    appid="plugin_ble_ext",
    apptype=FlipperAppType.PLUGIN,
    entry_point="plugin_ble_ext_ep",
    requires=["seos"],
    sources=["ble_ext_fal/*.c"],
    fal_embedded=True,
)

App(
    appid="plugin_ble_native",
    apptype=FlipperAppType.PLUGIN,
    entry_point="plugin_ble_native_ep",
    requires=["seos"],
    sources=["ble_native_fal/*.c"],
    fal_embedded=True,
)
